<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_line_message_send_wizard_form" model="ir.ui.view">
        <field name="name">line.message.send.wizard.form</field>
        <field name="model">line.message.send.wizard</field>
        <field name="arch" type="xml">
            <form string="ส่งข้อความทดสอบ">
                <group>
                    <field name="template_id" invisible="1"/>
                    <field name="send_method" widget="radio"/>
                    <field name="user_id" 
                           placeholder="กรอก LINE User ID"
                           attrs="{'invisible': [('send_method', '=', 'multicast')], 'required': [('send_method', '=', 'push')]}"/>
                    <field name="user_ids" 
                           widget="text"
                           placeholder="U1234567890abcdef1234567890abcdef,&#10;U0987654321fedcba0987654321fedcba"
                           attrs="{'invisible': [('send_method', '=', 'push')], 'required': [('send_method', '=', 'multicast')]}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>💡 วิธีส่ง:</strong>
                    <ul>
                        <li><strong>Push Message:</strong> กรอก User ID เดี่ยว</li>
                        <li><strong>Multicast:</strong> กรอก User IDs หลายตัวคั่นด้วยจุลภาค หรือขึ้นบรรทัดใหม่</li>
                    </ul>
                </div>
                <footer>
                    <button name="action_send" string="ส่งข้อความ" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

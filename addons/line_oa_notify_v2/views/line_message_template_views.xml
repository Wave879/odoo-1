<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Message Template Form View -->
    <record id="view_line_message_template_form" model="ir.ui.view">
        <field name="name">line.message.template.form</field>
        <field name="model">line.message.template</field>
        <field name="arch" type="xml">
            <form string="เทมเพลทข้อความ LINE">
                <header>
                    <button name="action_send_test" string="ส่งทดสอบ" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'active'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="ชื่อเทมเพลท"/></h1>
                    </div>
                    <group>
                        <group string="ข้อมูลพื้นฐาน">
                            <field name="message_type"/>
                            <field name="sequence"/>
                        </group>
                        <group string="อื่น ๆ">
                            <field name="description"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="การตั้งค่า LINE OA">
                            <field name="line_config_id" widget="many2many_tags" domain="[('is_active', '=', True)]"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Text Message -->
                        <page string="ข้อความ" attrs="{'invisible': [('message_type', '!=', 'text')]}">
                            <field name="text_content" nolabel="1" placeholder="พิมพ์ข้อความที่ต้องการส่ง (สูงสุด 5,000 ตัวอักษร)" style="width: 100%; min-height: 400px;"/>
                        </page>
                        
                        <!-- Image Message -->
                        <page string="รูปภาพ" attrs="{'invisible': [('message_type', '!=', 'image')]}">
                            <group>
                                <field name="image_url" placeholder="https://example.com/image.jpg"/>
                                <field name="preview_image_url" placeholder="https://example.com/preview.jpg (ถ้าไม่ระบุจะใช้ URL เดียวกับรูปต้นฉบับ)"/>
                            </group>
                        </page>
                        
                        <!-- Video Message -->
                        <page string="วิดีโอ" attrs="{'invisible': [('message_type', '!=', 'video')]}">
                            <group>
                                <field name="video_url" placeholder="https://example.com/video.mp4"/>
                                <field name="video_preview_url" placeholder="https://example.com/video_preview.jpg"/>
                            </group>
                        </page>
                        
                        <!-- Audio Message -->
                        <page string="เสียง" attrs="{'invisible': [('message_type', '!=', 'audio')]}">
                            <group>
                                <field name="audio_url" placeholder="https://example.com/audio.m4a"/>
                                <field name="audio_duration"/>
                            </group>
                        </page>
                        
                        <!-- Sticker Message -->
                        <page string="สติกเกอร์" attrs="{'invisible': [('message_type', '!=', 'sticker')]}">
                            <group>
                                <field name="sticker_package_id" placeholder="Package ID (เช่น 446)"/>
                                <field name="sticker_id" placeholder="Sticker ID (เช่น 1988)"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <p>ดูรายการสติกเกอร์ที่ใช้ได้ที่: <a href="https://developers.line.biz/en/docs/messaging-api/sticker-list/" target="_blank">LINE Sticker List</a></p>
                            </div>
                        </page>
                        
                        <!-- Location Message -->
                        <page string="ตำแหน่งที่ตั้ง" attrs="{'invisible': [('message_type', '!=', 'location')]}">
                            <group>
                                <group>
                                    <field name="location_title" placeholder="ชื่อสถานที่"/>
                                    <field name="location_address" placeholder="ที่อยู่"/>
                                </group>
                                <group>
                                    <field name="location_latitude"/>
                                    <field name="location_longitude"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Template & Flex Messages -->
                        <page string="Template/Flex JSON" attrs="{'invisible': [('message_type', 'not in', ['template_buttons', 'template_confirm', 'template_carousel', 'flex', 'imagemap'])]}">
                            <field name="template_json" nolabel="1" placeholder='{"type": "bubble", "body": {...}}' style="width: 100%; min-height: 400px;"/>
                        </page>
                        
                        <!-- Quick Reply -->
                        <page string="Quick Reply">
                            <field name="has_quick_reply"/>
                            <field name="quick_reply_json" attrs="{'invisible': [('has_quick_reply', '=', False)]}" placeholder='{"items": [{"type": "action", "action": {...}}]}' style="width: 100%; min-height: 300px;"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Message Template Tree View -->
    <record id="view_line_message_template_tree" model="ir.ui.view">
        <field name="name">line.message.template.tree</field>
        <field name="model">line.message.template</field>
        <field name="arch" type="xml">
            <tree string="เทมเพลทข้อความ">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="line_config_id"/>
                <field name="message_type"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Message Template Kanban View -->
    <record id="view_line_message_template_kanban" model="ir.ui.view">
        <field name="name">line.message.template.kanban</field>
        <field name="model">line.message.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="message_type">
                <field name="id"/>
                <field name="name"/>
                <field name="message_type"/>
                <field name="description"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="description"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge rounded-pill text-bg-info"><field name="message_type"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Message Template Action -->
    <record id="action_line_message_template" model="ir.actions.act_window">
        <field name="name">เทมเพลทข้อความ</field>
        <field name="res_model">line.message.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างเทมเพลทข้อความ LINE
            </p>
            <p>
                สร้างเทมเพลทข้อความสำหรับส่งผ่าน LINE Official Account
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View for Ez Font Settings -->
        <record id="ez_font_settings_tree" model="ir.ui.view">
            <field name="name">ez.font.settings.tree</field>
            <field name="model">ez.font.settings</field>
            <field name="arch" type="xml">
                <tree string="ตั้งค่าฟอนต์">
                    <field name="font_name"/>
                    <field name="google_font_url"/>
                    <field name="is_active"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Ez Font Settings -->
        <record id="ez_font_settings_form" model="ir.ui.view">
            <field name="name">ez.font.settings.form</field>
            <field name="model">ez.font.settings</field>
            <field name="arch" type="xml">
                <form string="ตั้งค่าฟอนต์">
                    <header>
                        <button name="action_apply_font" type="object" string="ใช้งานฟอนต์นี้" class="oe_highlight" attrs="{'invisible': [('is_active', '=', True)]}"/>
                        <button name="action_deactivate_font" type="object" string="ยกเลิกใช้งาน" attrs="{'invisible': [('is_active', '=', False)]}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="font_name"/>
                                <field name="is_active"/>
                            </group>
                            <group>
                                <field name="google_font_url"/>
                            </group>
                        </group>
                        <group string="ตั้งค่าขั้นสูง">
                            <field name="css_selectors" nolabel="1"/>
                        </group>
                        <group string="ข้อมูลเพิ่มเติม">
                            <field name="description" nolabel="1"/>
                        </group>
                        <group>
                            <field name="created_date"/>
                            <field name="modified_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View for Ez Font Settings -->
        <record id="ez_font_settings_search" model="ir.ui.view">
            <field name="name">ez.font.settings.search</field>
            <field name="model">ez.font.settings</field>
            <field name="arch" type="xml">
                <search string="ค้นหาฟอนต์">
                    <field name="font_name" string="ชื่อฟอนต์"/>
                    <separator/>
                    <filter name="active" string="ใช้งาน" domain="[('is_active', '=', True)]"/>
                    <filter name="inactive" string="ไม่ใช้งาน" domain="[('is_active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Action for Ez Font Settings -->
        <record id="ez_font_settings_action" model="ir.actions.act_window">
            <field name="name">ตั้งค่าฟอนต์</field>
            <field name="res_model">ez.font.settings</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ไม่มีฟอนต์ที่บันทึกไว้
                </p>
                <p>
                    กด "สร้าง" เพื่อเพิ่มฟอนต์ใหม่
                </p>
            </field>
        </record>

        <!-- Menu Item for Ez Font Settings -->
        <menuitem 
            id="ez_font_settings_menu" 
            name="ตั้งค่าฟอนต์"
            parent="base.menu_administration"
            action="ez_font_settings_action"
            sequence="100"/>

    </data>
</odoo>
